   "source": [
    "nums = []\n",
    "while True:\n",
    "    user_input = input('Enter a number (or press Ctrl+Enter to quit):')\n",
    "    if user_input == '':\n",
    "        break\n",
    "    nums.append(float(user_input))\n",
    "if nums:\n",
    "    print(f'Smallest: {min(nums)}')\n",
    "    print(f'Largest: {max(nums)}')"
   ],
