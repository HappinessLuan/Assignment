   "source": [
    "import random\n",
    "target = random.randint(1,10)\n",
    "guess = 0\n",
    "while guess != target:\n",
    "    guess = int(input('Guess a number between 1 and 10:'))\n",
    "    if guess < target:\n",
    "        print('Too low')\n",
    "    elif guess > target:\n",
    "        print('Too high')\n",
    "    else:\n",
    "        print('Correct')"
   ],
