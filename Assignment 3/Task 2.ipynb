   "source": [
    "while True:\n",
    "    inches = float(input('Enter inches (negative to quit):'))\n",
    "    if inches < 0:\n",
    "        break\n",
    "    cm = inches * 2.54\n",
    "    print(f'{inches} inches is {cm} cm')"
   ],
