   "source": [
    "def make_acronym(phrase):\n",
    "    words = phrase.split()\n",
    "    acronym = ''\n",
    "    for word in words:\n",
    "        acronym += word[0].upper()\n",
    "    return acronym\n",
    "\n",
    "input = input('Enter a phrase:')\n",
    "acronym = make_acronym(input)\n",
    "print('The acronym is:', acronym)"
   ],
